// Signal-name adaptation between the existing checker bus and upstream VIP.
`define NI_AXI_UVM_MASTER(bus, vip) \
    assign bus.aw_id = vip.awid; \
    assign bus.aw_addr = vip.awaddr; \
    assign bus.aw_len = vip.awlen; \
    assign bus.aw_size = vip.awsize; \
    assign bus.aw_burst = vip.awburst; \
    assign bus.aw_lock = vip.awlock; \
    assign bus.aw_cache = vip.awcache; \
    assign bus.aw_prot = vip.awprot; \
    assign bus.aw_qos = vip.awqos; \
    assign bus.aw_region = vip.awregion; \
    assign bus.aw_user = vip.awuser; \
    assign bus.aw_valid = vip.awvalid; \
    assign bus.w_data = vip.wdata; \
    assign bus.w_strb = vip.wstrb; \
    assign bus.w_last = vip.wlast; \
    assign bus.w_valid = vip.wvalid; \
    assign bus.b_ready = vip.bready; \
    assign bus.ar_id = vip.arid; \
    assign bus.ar_addr = vip.araddr; \
    assign bus.ar_len = vip.arlen; \
    assign bus.ar_size = vip.arsize; \
    assign bus.ar_burst = vip.arburst; \
    assign bus.ar_lock = vip.arlock; \
    assign bus.ar_cache = vip.arcache; \
    assign bus.ar_prot = vip.arprot; \
    assign bus.ar_qos = vip.arqos; \
    assign bus.ar_region = vip.arregion; \
    assign bus.ar_valid = vip.arvalid; \
    assign bus.r_ready = vip.rready; \
    assign vip.awready = bus.aw_ready; \
    assign vip.wready = bus.w_ready; \
    assign vip.bid = bus.b_id; \
    assign vip.bresp = tvip_axi_types_pkg::tvip_axi_response'(bus.b_resp); \
    assign vip.bvalid = bus.b_valid; \
    assign vip.arready = bus.ar_ready; \
    assign vip.rid = bus.r_id; \
    assign vip.rdata = bus.r_data; \
    assign vip.rresp = tvip_axi_types_pkg::tvip_axi_response'(bus.r_resp); \
    assign vip.rlast = bus.r_last; \
    assign vip.rvalid = bus.r_valid; \
    assign bus.aw_atop = '0; \
    assign bus.w_user = '0; \
    assign bus.ar_user = '0;

`define NI_AXI_UVM_SLAVE(bus, vip) \
    assign vip.awid = bus.aw_id; \
    assign vip.awaddr = bus.aw_addr; \
    assign vip.awlen = bus.aw_len; \
    assign vip.awsize = tvip_axi_types_pkg::tvip_axi_burst_size'(bus.aw_size); \
    assign vip.awburst = tvip_axi_types_pkg::tvip_axi_burst_type'(bus.aw_burst); \
    assign vip.awlock = bus.aw_lock; \
    assign vip.awcache = tvip_axi_types_pkg::tvip_axi_write_cache'(bus.aw_cache); \
    assign vip.awprot = tvip_axi_types_pkg::tvip_axi_protection'(bus.aw_prot); \
    assign vip.awqos = bus.aw_qos; \
    assign vip.awregion = bus.aw_region; \
    assign vip.awuser = bus.aw_user; \
    assign vip.awvalid = bus.aw_valid; \
    assign vip.wdata = bus.w_data; \
    assign vip.wstrb = bus.w_strb; \
    assign vip.wlast = bus.w_last; \
    assign vip.wvalid = bus.w_valid; \
    assign vip.bready = bus.b_ready; \
    assign vip.arid = bus.ar_id; \
    assign vip.araddr = bus.ar_addr; \
    assign vip.arlen = bus.ar_len; \
    assign vip.arsize = tvip_axi_types_pkg::tvip_axi_burst_size'(bus.ar_size); \
    assign vip.arburst = tvip_axi_types_pkg::tvip_axi_burst_type'(bus.ar_burst); \
    assign vip.arlock = bus.ar_lock; \
    assign vip.arcache = tvip_axi_types_pkg::tvip_axi_read_cache'(bus.ar_cache); \
    assign vip.arprot = tvip_axi_types_pkg::tvip_axi_protection'(bus.ar_prot); \
    assign vip.arqos = bus.ar_qos; \
    assign vip.arregion = bus.ar_region; \
    assign vip.arvalid = bus.ar_valid; \
    assign vip.rready = bus.r_ready; \
    assign bus.aw_ready = vip.awready; \
    assign bus.w_ready = vip.wready; \
    assign bus.b_id = vip.bid; \
    assign bus.b_resp = vip.bresp; \
    assign bus.b_valid = vip.bvalid; \
    assign bus.ar_ready = vip.arready; \
    assign bus.r_id = vip.rid; \
    assign bus.r_data = vip.rdata; \
    assign bus.r_resp = vip.rresp; \
    assign bus.r_last = vip.rlast; \
    assign bus.r_valid = vip.rvalid; \
    assign bus.b_user = '0; \
    assign bus.r_user = '0;
